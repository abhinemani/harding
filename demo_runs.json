g","citation":"Governor's Office for Children Local Management Board agreement"},"strategic_linkage":"Livable Frederick \u00b7 thriving children and youth","alignment":"contributes","twenty_percent":{"minus":"Two provider contracts end; about 240 participants lose services and the County's state match is at risk.","plus":"A new Healthy Families cohort is funded, adding roughly 60 home-visited families."},"is_admin":false},{"name":"Family Partnership Home Visiting","facing":"external","statement":"Family Partnership Home Visiting delivers voluntary home visits, parenting coaching, and the Judy Center's school-readiness services to expectant parents and families with young children so that children are healthy, safe, and developmentally on track at kindergarten entry","beneficiary":"About 220 families a year, prenatal through age five, prioritizing first-time and low-income parents","fte":7.5,"item_ids":[13,19,27,32,43,48,52,57,62,68,71,76,83,93,94,98,102,113,114,131,139,143,146,153,155,156,158,167,175,180,182,183,185],"allocation_note":"The General Fund Family Partnership center plus the Judy Center grant, which places an early-childhood coordinator at a Title I elementary school. Interpreter services ($25,000) sit here because most home visits are conducted in Spanish or with interpretation.","contributing_divisions":"Frederick County Public Schools (Judy Center site and staff); Health Department (referrals)","measures":{"result":{"metric":"Share of children screened on schedule and on track for kindergarten","source":"Parents as Teachers data system","exists_today":"likely"},"volume":{"metric":"Home visits completed","source":"Parents as Teachers data system","exists_today":"likely"},"unit_cost":{"metric":"Cost per home visit","source":"Munis \u00f7 visit logs","exists_today":"possible"}},"mandate":{"status":"required to receive funding","citation":"Judy Center grant (MSDE); Family Partnership is discretionary County service"},"strategic_linkage":"Livable Frederick \u00b7 strong, supported families and school readiness","alignment":"direct","twenty_percent":{"minus":"Two home-visitor caseloads close; about 60 families lose visits and Spanish-language capacity drops by half.","plus":"Enrollment opens to all first-time parents countywide, adding roughly 80 families."},"is_admin":false},{"name":"Youth Transition Services","facing":"external","statement":"Youth Transition Services delivers case management, GED preparation, and interagency care planning to young people aged 14 to 24 who are disconnected from school, family, or work so that they earn a credential and reach stable housing and employment","beneficiary":"Roughly 180 youth a year, referred by schools, courts, and shelters countywide","fte":2.5,"item_ids":[1,21,25,29,30,33,37,44,45,51,64,67,70,77,84,86,96,97,112,119,121,122,125,126,127,132,133,138,142,148,154,157,159,162,165,168,169,171,181],"allocation_note":"Three small centers: Non-Parenting Youth (General Fund case management), GED Youth (fully recovered from a partner, so net General Fund cost is zero), and the Local Care Team, an interagency panel for youth with intensive needs.","contributing_divisions":"Frederick County Public Schools (alternative programs); Workforce Services (employment placement); Juvenile Services (referrals)","measures":{"result":{"metric":"Share of enrolled youth earning a GED or re-enrolling in school within 12 months","source":"Case files and GED Testing Service records","exists_today":"possible"},"volume":{"metric":"Youth enrolled and case-management contacts","source":"Case management logs","exists_today":"likely"},"unit_cost":{"metric":"Cost per youth served","source":"Munis \u00f7 case logs","exists_today":"possible"}},"mandate":{"status":"discretionary","citation":""},"strategic_linkage":"Livable Frederick \u00b7 thriving children and youth","alignment":"contributes","twenty_percent":{"minus":"GED preparation ends unless the partner recovery continues; caseloads cap at 25 and referr